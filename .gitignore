# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging (root-level setuptools output only — not app content
# that happens to sit under a directory named build/ or dist/)
/build/
/dist/
*.egg-info/
.eggs/

# Unit test / coverage reports
.pytest_cache/
.coverage
